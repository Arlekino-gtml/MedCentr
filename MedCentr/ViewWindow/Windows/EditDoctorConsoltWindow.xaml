<Window x:Class="MedCentr.ViewWindow.Windows.EditDoctorConsoltWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedCentr.ViewWindow.Windows"
        mc:Ignorable="d"
        Title="EditDoctorConsoltWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0 0 0 10">
            <TextBlock Text="Редактирование консультации" FontSize="23" FontWeight="SemiBold" Foreground="#4F46A5"/>
            <TextBlock Text="Измените данные и нажмите «Сохранить»" FontSize="13" Foreground="Black" Opacity="0.5" Margin="0 5 0 0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#DAD7F5" BorderThickness="1" CornerRadius="12" Padding="18">
            <StackPanel>
                    <TextBlock Text="Диагноз" FontSize="14" FontWeight="SemiBold" Foreground="#4F46A5"/>
                    <TextBox Name="DiagnosisTextBox"  MaxLength="100" MinHeight="38" Padding="8" Margin="0 5 0 15" FontSize="14" BorderBrush="#DAD7F5" BorderThickness="1" TextWrapping="Wrap" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Рекомендации" FontSize="14" FontWeight="SemiBold" Foreground="#4F46A5"/>
                    <TextBox Name="RecommendationsTextBox" MaxLength="500" Height="44" Padding="8" Margin="0 5 0 15" FontSize="14" BorderBrush="#DAD7F5" BorderThickness="1" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="Назначения" FontSize="14" FontWeight="SemiBold" Foreground="#4F46A5"/>
                    <TextBox Name="PrescriptionsTextBox" MaxLength="300" Height="90" Padding="8" Margin="0 5 0 15" FontSize="14" BorderBrush="#DAD7F5" BorderThickness="1" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="Дата обновления" FontSize="14" FontWeight="SemiBold" Foreground="#4F46A5"/>
                    <DatePicker Name="FollowUpDatePicker"  Height="35" Margin="0 5 0 5" FontSize="14"/>

                </StackPanel>
           
        </Border>

            <Button  HorizontalAlignment="Right"  Grid.Row="2" Name="SaveButton" Content="Сохранить" Width="130" Height="38" Background="#625BD4" Foreground="White" BorderThickness="0" FontSize="14"/>

    </Grid>
</Window>