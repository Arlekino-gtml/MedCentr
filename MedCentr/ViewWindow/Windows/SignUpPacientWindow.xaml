<Window x:Class="MedCentr.ViewWindow.Windows.SignUpPacientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedCentr.ViewWindow.Windows"
        mc:Ignorable="d"
        Title="SignUpPacientWindow" Height="450" Width="800" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>
        <!--дизайн 0 строки 0 колонка-->
        <Grid Background="#7171FF">
            <TextBlock  Foreground="White" FontSize="15"  FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
        Медицинский центр 
        <LineBreak/>
        «Здоровье рядом»

            </TextBlock>
            <!--дизайн 0 строки 1 колонка-->
        </Grid>
        <Grid Grid.Column="1">
            <TextBlock Text="Запись на приём" FontSize="30" VerticalAlignment="Center" Name="PageTitleText"  Padding="10 0 0 0"/>
        </Grid>

        <!--Левая колонка-->
        <StackPanel  Grid.Row="1" Background="#5E5ED8" >
            <Button Content="Мои записи" Height="30" Width="100" Margin="0 30 0 10 " Background="White" BorderBrush="White" />
            <Button Content="Результаты" Height="30" Width="100" Margin="0 10 0 10 " Background="White" BorderBrush="White"/>
            <Button Content="Наши врачи" Height="30" Width="100" Margin="0 10 0 10 " Background="White" BorderBrush="White"/>
            <Button Content="Выйти" Height="30" Width="100" Margin="0 55 0 10 " Background="Black" Foreground="White" />
        </StackPanel>
        <!--правая часть окна-->
        <Grid Grid.Column="1" Grid.Row="1" Background="#B2B2F9">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.2*" />
                <RowDefinition Height="6*"/>
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="1"  Background="White"  VerticalAlignment="Center" CornerRadius="30" Width="500" Height="300" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition />
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Выберите врача, дату и удобное время посещения."  Grid.ColumnSpan="4"  HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="15" />

                    <StackPanel Grid.Column="1" Grid.Row="1"  Grid.RowSpan="6" Margin="10">

                        <TextBlock Text="Врач" HorizontalAlignment="Left" Margin="10 10 0 0" /><!-- IsEditable="False"запрещает ручной вввод--> 
                        <ComboBox x:Name="DoctorBox" Width="140" Height="25" IsEditable="False"  HorizontalAlignment="Left" Margin="10 10 0 0" ><!--выдвигающийся список-->
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FIO}"/>
                                        <TextBlock Text="{Binding Specialty}" Opacity="0.5" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox> 
                        
                        <!--выбор даты-->
                        <TextBlock Text="Дата" HorizontalAlignment="Left" Margin="10 10 0 0"/>
                        <DatePicker x:Name="DateBox" Width="140" Height="25" HorizontalAlignment="Left" Margin="10 10 0 0"/>

                        <!--выбор времени-->
                        <TextBlock Text="Время" HorizontalAlignment="Left" Margin="10 10 0 0"/>
                        <ComboBox Name="TimeBox" IsEditable="False" Width="140" Height="25" HorizontalAlignment="Left" Margin="10 10 0 0"/>

                    </StackPanel>
                    <Image Source="/Images/Doctor.jpg" Grid.Column="3" Grid.Row="1" Grid.RowSpan="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="Записаться" Background="#5E5ED8" BorderBrush="#5E5ED8" Foreground="White" Grid.Column="3" Grid.Row="6" Width="150" Height="28"  HorizontalAlignment="Left" Margin="44 6 0 6" Click="AddSigUpButton_Click" />
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
