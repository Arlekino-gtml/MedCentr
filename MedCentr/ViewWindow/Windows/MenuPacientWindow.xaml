<Window x:Class="MedCentr.ViewWindow.Windows.MenuPacientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedCentr.ViewWindow.Windows"
        mc:Ignorable="d"
        Title="MenuPacientWindow" Height="450" Width="800" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>
        <!--дизайн 0 строки 0 колонка-->
        <Grid Background="#7171FF">
            <TextBlock  Foreground="White" FontSize="15"  FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                Медицинский центр 
                <LineBreak/>
                «Здоровье рядом»

            </TextBlock>
            <!--дизайн 0 строки 1 колонка-->
        </Grid>
        <Grid Grid.Column="1">
            <TextBlock Text="Главная" FontSize="30" VerticalAlignment="Center" Name="PageTitleText"  Padding="10 0 0 0"/>
        </Grid>

        <!--Левая колонка-->
        <StackPanel  Grid.Row="1" Background="#5E5ED8" >
            <Button Content="Мои записи" Height="30" Width="100" Margin="0 30 0 10 " Background="White" BorderBrush="White" Click="MyRecordButton_Click"/>
            <Button Content="Результаты" Height="30" Width="100" Margin="0 10 0 10 " Background="White" BorderBrush="White" Click="ResultButton_Click"/>
            <Button Content="Наши врачи" Height="30" Width="100" Margin="0 10 0 10 " Background="White" BorderBrush="White" Click="MyDoctorButton_Click"/>
            <Button Content="Выйти" Height="30" Width="100" Margin="0 55 0 10 " Background="Black" Foreground="White" />
        </StackPanel>
        <!--правая часть окна-->
        <Grid Grid.Column="1" Grid.Row="1" Background="#B2B2F9">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.2*" />
                <RowDefinition Height="6*"/>
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="1"  Background="White"  VerticalAlignment="Center" CornerRadius="30" Width="500" Height="300" >
                <StackPanel>
                    <TextBlock  Grid.Row="1" Text="Добро пожаловать, Леонид Николаевич! Вы находитесь в личном кабинете медицинского центра «Здоровье рядом». Здесь вы можете ознакомиться с  врачами , записаться на приём в удобное время, просматривать свои записи и результаты консультаций. Выберите нужный раздел в меню слева или воспользуйтесь кнопкой ниже." TextWrapping="Wrap" FontSize="19" Padding="20 20 10 18" FontWeight="Bold" />
                    <Button Content="Записаться на прием" Width="250" Height="41" FontSize="18" Background="#5E5ED8" Foreground="White" VerticalAlignment="Center" Click="MainFrameSigUp_Navigated" />
                </StackPanel>
            </Border>

        </Grid>
        <Frame Name="MainFrame" Grid.Row="1" Grid.Column="1"  />
    </Grid>
</Window>
