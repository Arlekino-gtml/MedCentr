<Page x:Class="MedCentr.ViewWindow.Pages.MyDoctorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MedCentr.ViewWindow.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MyDoctorPage" Background="White">

    <Grid>
        <!--список для страницы наши врачи-->
        <ListBox Name="LstMyDoctor">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>

                    <Border Background="#483D8B	"
                       CornerRadius="8"
                       Padding="10"
                       Margin="4" MinHeight="180"
                       Height="Auto" Width="300">


                        <StackPanel>

                            <Image Source="{Binding Image}" />
                            <TextBlock Text="{Binding FIO,StringFormat=Врач: {0}}" FontSize="14" TextWrapping="Wrap" Foreground="White"/>
                            <TextBlock Text="{Binding Specialty,StringFormat=Специальность: {0}}" FontSize="14" TextWrapping="Wrap" Foreground="White"/>
                            <TextBlock Text="{Binding Education,StringFormat=Образование: {0}}" FontSize="14" TextWrapping="Wrap" Foreground="White"/>
                            <TextBlock Text="{Binding Experience,StringFormat=Опыт: {0}}" FontSize="14" TextWrapping="Wrap" Foreground="White"/>
                            <TextBlock Text="{Binding Position,StringFormat=Должность: {0}}" FontSize="14" TextWrapping="Wrap" Foreground="White"/>


                        </StackPanel>

                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
