<Page x:Class="MedCentr.ViewWindow.Pages.MyDoctorRecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MedCentr.ViewWindow.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MyDoctorRecordPage" Background="White">

    <Grid>
        <Grid  >
            
            
            <ListBox Name="LstDoctorRecord" SelectionChanged="LstDoctorRecord_SelectionChanged" >
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent" BorderThickness="2" BorderBrush="Black" Padding="10" Margin="5" Width="290">
                        <StackPanel >
                            
                            <TextBlock Text="{Binding User.FIO,StringFormat=Пациент: {0}}"
                           FontSize="15"
                           
                           Foreground="#1F2937" />


                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="{Binding AppointmentDate, StringFormat=Дата приема: {0:dd.MM.yyyy}}"
                       FontSize="13"
                       Foreground="#191970"
                       VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding StartTime, StringFormat=в {0:hh\\:mm}}"
                       FontSize="13"
                       Foreground="#6A5ACD"
                       Margin="5 0 0 0"
                       VerticalAlignment="Center"/>
                          
                            </StackPanel>
                            
          
                        </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </Grid>
    </Grid>
</Page>
