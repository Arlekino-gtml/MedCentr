<Page x:Class="MedCentr.ViewWindow.Pages.MyRecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MedCentr.ViewWindow.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MyRecordPage">

    <Grid>

        <Grid  Grid.Row="1" Background="White" >
            <Grid.RowDefinitions>
                <RowDefinition Height="1.2*" />
                <RowDefinition Height="6*"/>
            </Grid.RowDefinitions>
            <!--Поиск, добавление, изменение и удаление записей-->
            <StackPanel Orientation="Horizontal" Margin="8" HorizontalAlignment="Right" >
                <TextBox Name="SearchBox" Width="190" Margin="10 0 0 0"  Height="35"/>
                <Button Content="Найти"  Width="60" Height="35" Margin="10 0 0 0" Background="Black" Foreground="White" Click="SearchButton_Click" />
                <Button Content="Сброс"  Width="90" Height="35" Margin="10 0 0 0" Background="Black" Foreground="White" Click="ResetButton_Click" />
                <Button Content="Отменить запись" Width="120" Height="35" Margin="10 0 0 0" Background="#CE4348" Foreground="White" BorderBrush="#750E11" Click="CanselButton_Click"/>
                <Button Content="Главная" Width="80" Height="35" Margin="10 0 0 0" Background="Black" Foreground="White"  Click="BackMenuPacientButton_Click"/>

            </StackPanel >
            <ListBox Name="LstAppointment" Grid.Row="1">
                <ListBox.ItemTemplate>
                <DataTemplate>
                        <StackPanel >
                                <TextBlock Text="{Binding User.FIO,StringFormat=Врач {0}}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"/>

                                <TextBlock Text="{Binding User.Specialty}"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,2,0,6"/>




                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="{Binding AppointmentDate, StringFormat=Дата приема: {0:dd.MM.yyyy}}"
                               FontSize="13"
                               Foreground="#191970"
                               VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding StartTime, StringFormat=в {0:hh\\:mm}}"
                               FontSize="13"
                               Foreground="#6A5ACD"
                               Margin="5 0 0 0"
                               VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding Office.idOffice, StringFormat=кабинет: {0}}"
                               FontSize="13"
                               Foreground="#6A5ACD"
                               Margin="5 0 0 0"
                               VerticalAlignment="Center"/>
                                

                            </StackPanel>





                        </StackPanel>

                   
                </DataTemplate>
            </ListBox.ItemTemplate>

            </ListBox>
            
        </Grid>

    </Grid>
</Page>
